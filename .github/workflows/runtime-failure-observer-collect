    r"(?:"
    r"(?:^|\s)(?:[^\s\"']*[\\/])?xharness(?:\.exe)?\s+"
    r"(?:apple|android|wasm)\b"
    r"|"
    r"(?:^|\s)dotnet(?:\.exe)?\s+exec\s+"
