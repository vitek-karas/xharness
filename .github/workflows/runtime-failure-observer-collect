class CollectorError(RuntimeError):
    def __init__(
        self,
        code: str,
        message: str,
        *,
        scope: dict[str, Any] | None = None,
    ) -> None:
        super().__init__(message)
        self.code = code
        self.scope = scope or {}

    def as_json(self) -> dict[str, Any]:
        return {"code": self.code, "message": str(self), "scope": self.scope}


